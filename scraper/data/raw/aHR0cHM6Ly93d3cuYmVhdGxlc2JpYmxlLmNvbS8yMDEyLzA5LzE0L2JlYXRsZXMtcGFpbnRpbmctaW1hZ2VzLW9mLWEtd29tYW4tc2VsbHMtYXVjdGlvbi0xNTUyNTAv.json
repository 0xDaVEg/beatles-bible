esbible.com/wp/media/images-of-a-woman_1966_japan_06-133x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"The Beatles painting Images Of A Woman, Tokyo, 1966\" data-srcset=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_06-133x200.jpg 133w, https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_06.jpg 342w\" data-sizes=\"(max-width: 133px) 100vw, 133px\" data-attachment-id=\"12407\" data-permalink=\"https://www.beatlesbible.com/gallery/1966-photos/images-of-a-woman_1966_japan_06/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_06.jpg\" data-orig-size=\"342,514\" data-comments-opened=\"1\" data-image-title=\"The Beatles painting Images Of A Woman, Tokyo, 1966\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_06.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon portrait\">\n<a href=\"https://www.beatlesbible.com/gallery/1966-photos/images-of-a-woman_1966_japan_07/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMzIiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMTMyIDIwMCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"132\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_07-132x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"The Beatles painting Images Of A Woman, Tokyo, 1966\" data-srcset=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_07-132x200.jpg 132w, https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_07.jpg 358w\" data-sizes=\"(max-width: 132px) 100vw, 132px\" data-attachment-id=\"12408\" data-permalink=\"https://www.beatlesbible.com/gallery/1966-photos/images-of-a-woman_1966_japan_07/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_07.jpg\" data-orig-size=\"358,541\" data-comments-opened=\"1\" data-image-title=\"The Beatles painting Images Of A Woman, Tokyo, 1966\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_07.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon landscape\">\n<a href=\"https://www.beatlesbible.com/gallery/1966-photos/images-of-a-woman_1966_japan_08/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMDAiIGhlaWdodD0iMTU3IiB2aWV3Qm94PSIwIDAgMjAwIDE1NyI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"157\" data-src=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08-200x157.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"The Beatles painting Images Of A Woman, Tokyo, 1966\" data-srcset=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08-200x157.jpg 200w, https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08-580x456.jpg 580w, https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08-960x755.jpg 960w, https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08-768x604.jpg 768w, https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08-1536x1208.jpg 1536w, https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08.jpg 1600w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"12409\" data-permalink=\"https://www.beatlesbible.com/gallery/1966-photos/images-of-a-woman_1966_japan_08/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08.jpg\" data-orig-size=\"1600,1258\" data-comments-opened=\"1\" data-image-title=\"The Beatles painting Images Of A Woman, Tokyo, 1966\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/images-of-a-woman_1966_japan_08-960x755.jpg\"></a></div></figure></div><p>In September 2012 it was put up for sale again through Philip Weiss Auctions in New York. The painting had a pre-auction estimate of $80,000 to $120,000, but sold for $155,250 including the buyer’s premium.</p><p>It is not known whether The Beatles collaborated on any other paintings, but a pen and pencil drawing known as ‘Peace To Monterey’ was created in 1967 by the group. Unable to attend or perform at the Monterey Festival, they sent their best wishes to the organisers in the form of the drawing on paper.</p><p><a href=\"/gallery/miscellany/peace-to-monterey/\" rel=\"attachment wp-att-13736\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIzNTEiIGhlaWdodD0iNTgwIiB2aWV3Qm94PSIwIDAgMzUxIDU4MCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" data-attachment-id=\"13736\" data-permalink=\"https://www.beatlesbible.com/gallery/miscellany/peace-to-monterey/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/peace-to-monterey.jpg\" data-orig-size=\"500,824\" data-comments-opened=\"1\" data-image-title=\"Peace To Monterey artwork by The Beatles, 1967\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/peace-to-monterey.jpg\" data-src=\"/wp/media/peace-to-monterey-351x580.jpg\" alt=\"Peace To Monterey artwork by The Beatles, 1967\" width=\"351\" height=\"580\" class=\"aligncenter size-medium wp-image-13736\"></a></p>\n<!--[googlesitekit-end-of-content]--><div style=\"font-size: 12px; margin: 10px 0 10px 0;\"><strong>Page last updated:</strong> 22 September 2021</div></div></div><div class=\"on-this-day-wrapper\"><h3>Also on this day...</h3><ul><li>2024: <a href=\"https://www.beatlesbible.com/2024/09/14/ringo-starr-all-starr-band-live-performing-arts-pavilion-new-lenox/\">R