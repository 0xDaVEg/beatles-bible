0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_03-200x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"\" data-srcset=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_03-200x200.jpg 200w, https://www.beatlesbible.com/wp/media/alternative-please-please-me_03-66x66.jpg 66w, https://www.beatlesbible.com/wp/media/alternative-please-please-me_03.jpg 460w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"9063\" data-permalink=\"https://www.beatlesbible.com/gallery/alternative-images/alternative-please-please-me_03/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_03.jpg\" data-orig-size=\"460,458\" data-comments-opened=\"1\" data-image-title=\"alternative-please-please-me_03\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_03.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon landscape\">\n<a href=\"https://www.beatlesbible.com/gallery/alternative-images/alternative-please-please-me_02/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMDAiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMjAwIDIwMCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_02-200x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"\" data-srcset=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_02-200x200.jpg 200w, https://www.beatlesbible.com/wp/media/alternative-please-please-me_02-66x66.jpg 66w, https://www.beatlesbible.com/wp/media/alternative-please-please-me_02.jpg 401w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"9062\" data-permalink=\"https://www.beatlesbible.com/gallery/alternative-images/alternative-please-please-me_02/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_02.jpg\" data-orig-size=\"401,401\" data-comments-opened=\"1\" data-image-title=\"alternative-please-please-me_02\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_02.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon portrait\">\n<a href=\"https://www.beatlesbible.com/gallery/alternative-images/alternative-please-please-me_01/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMDAiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMjAwIDIwMCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_01-200x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"\" data-srcset=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_01-200x200.jpg 200w, https://www.beatlesbible.com/wp/media/alternative-please-please-me_01-66x66.jpg 66w, https://www.beatlesbible.com/wp/media/alternative-please-please-me_01.jpg 447w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"9061\" data-permalink=\"https://www.beatlesbible.com/gallery/alternative-images/alternative-please-please-me_01/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_01.jpg\" data-orig-size=\"447,448\" data-comments-opened=\"1\" data-image-title=\"alternative-please-please-me_01\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/alternative-please-please-me_01.jpg\"></a></div></figure></div><p>The Beatles recreated the <em>Please Please Me</em> shoot in 1969 for the aborted <em>Get Back</em> album. An image from that session was also used on the Red and Blue albums. The <em>Get Back</em> album was released in October 2021 as part of the <a href=\"/albums/let-it-be/\"><em>Let It Be</em></a> super deluxe CD and vinyl box sets.</p><div data-carousel-extra=\"{&quot;blog_id&quot;:1,&quot;permalink&quot;:&quot;https://www.beatlesbible.com/1963/02/16/please-please-me-cover-photoshoot/&quot;}\" id=\"gallery-3\" class=\"gallery galleryid-119638 gallery-columns-3 gallery-size-thumbnail\"><figure class=\"gallery-item\"><div class=\"gallery-icon portrait\">\n<a href=\"https://www.beatlesbible.com/gallery/releases/get-back-lp_01/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxOTYiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMTk2IDIwMCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"196\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/get-back-lp_01-196x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"The Beatles –&nbsp;Get Back album artwork\" data-srcset=\"https://www.beatlesbible.com/wp/media/get-back-lp_01-196x200.jpg 196w, https://www.beatlesbible.com/wp/media/get-back-lp_01-569x580.jpg 569w, https://www.beatlesbible.com/wp/media/get-back-lp_01-941x960.jpg 941w, https://www.beatlesbible.com/wp/media/get-back-lp_01-768x783.jpg 768w, https://www.beatlesbible.com/wp/media/get-back-lp_01-1506x1536.jpg 1506w, https://www.beatlesbible.com/wp/media/get-back-lp_01-66x66.jpg 66w, https://www.beatlesbible.com/wp/media/get-back-lp_01.jpg 1935w\" data-sizes=\"(max-width: 196px) 100vw, 196px\" data-attachment-id=\"100548\" data-permalink=\"https://www.beatlesbible.com/gallery/releases/get-back-lp_01/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/get-back-lp_01.jpg\" data-orig-size=\"1935,1974\" data-comments-opened=\"1\" data-image-title=\"The Beatles –&nbsp;Get Back album artwo