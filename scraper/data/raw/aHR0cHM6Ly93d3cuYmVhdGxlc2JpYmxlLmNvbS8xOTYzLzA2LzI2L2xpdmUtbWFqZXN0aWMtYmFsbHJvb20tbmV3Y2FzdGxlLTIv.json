le.com/wp/media/germany_she_loves_you.jpg\" data-orig-size=\"710,717\" data-comments-opened=\"1\" data-image-title=\"She Loves You single – Germany\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/germany_she_loves_you.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon landscape\">\n<a href=\"https://www.beatlesbible.com/gallery/releases/denmark_she_loves_you/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMDAiIGhlaWdodD0iMTkxIiB2aWV3Qm94PSIwIDAgMjAwIDE5MSI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"191\" data-src=\"https://www.beatlesbible.com/wp/media/denmark_she_loves_you-200x191.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"She Loves You single artwork - Denmark\" data-srcset=\"https://www.beatlesbible.com/wp/media/denmark_she_loves_you-200x191.jpg 200w, https://www.beatlesbible.com/wp/media/denmark_she_loves_you-580x554.jpg 580w, https://www.beatlesbible.com/wp/media/denmark_she_loves_you-960x918.jpg 960w, https://www.beatlesbible.com/wp/media/denmark_she_loves_you-768x734.jpg 768w, https://www.beatlesbible.com/wp/media/denmark_she_loves_you.jpg 1000w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"9274\" data-permalink=\"https://www.beatlesbible.com/gallery/releases/denmark_she_loves_you/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/denmark_she_loves_you.jpg\" data-orig-size=\"1000,956\" data-comments-opened=\"1\" data-image-title=\"She Loves You single artwork – Denmark\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/denmark_she_loves_you-960x918.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon landscape\">\n<a href=\"https://www.beatlesbible.com/gallery/releases/portugal_she_loves_you_ep/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMDAiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMjAwIDIwMCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep-200x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"She Loves You EP artwork - Portugal\" data-srcset=\"https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep-200x200.jpg 200w, https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep-580x578.jpg 580w, https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep-960x957.jpg 960w, https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep-768x766.jpg 768w, https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep-66x66.jpg 66w, https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep.jpg 1000w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"9999\" data-permalink=\"https://www.beatlesbible.com/gallery/releases/portugal_she_loves_you_ep/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep.jpg\" data-orig-size=\"1000,997\" data-comments-opened=\"1\" data-image-title=\"She Loves You EP artwork – Portugal\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/portugal_she_loves_you_ep-960x957.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon portrait\">\n<a href=\"https://www.beatlesbible.com/gallery/releases/norway_she_loves_you/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxODkiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMTg5IDIwMCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"189\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/norway_she_loves_you-189x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"She Loves You single artwork - Norway\" data-srcset=\"https://www.beatlesbible.com/wp/media/norway_she_loves_you-189x200.jpg 189w, https://www.beatlesbible.com/wp/media/norway_she_loves_you-547x580.jpg 547w, https://www.beatlesbible.com/wp/media/norway_she_loves_you-906x960.jpg 906w, https://www.beatlesbible.com/wp/media/norway_she_loves_you-768x814.jpg 768w, https://www.beatlesbible.com/wp/media/norway_she_loves_you.jpg 1000w\" data-sizes=\"(max-width: 189px) 100vw, 189px\" data-attachment-id=\"9853\" data-permalink=\"https://www.beatlesbible.com/gallery/releases/norway_she_loves_you/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/norway_she_loves_you.jpg\" data-orig-size=\"1000,1060\" data-comments-opened=\"1\" data-image-title=\"She Loves You single artwork – Norway\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/norway_she_loves_you-906x960.jpg\"></a></div></figure></div><blockquote><div>John and I wrote ‘She Loves You’ together. There was a Bobby Rydell song [‘Forget Him’] out at the time and, as often happens, you think of one song when you write another.<p></p><p>We were in a van up in Newcastle. I’d planned an ‘answering song’ where a couple of us would sing ‘She loves you…’ and the other one answers, ‘Yeah, yeah.’ We decided that that was a crummy idea as it was, but at least we then had the idea for a song called ‘She Loves You’. So we sat in the hotel bedroom for a few hours and wrote it.</p></div></blockquote><div class=\"source\">Paul McCartney<br>\n<a href=\"https://geni.us/anthologypb\" target=\"_blank\" rel=\"noopener\"><em>Anthology</em></a></div><p>They wrote while facing each other on twin beds in their shared hotel room.</p><blockquote><div>We must have had a few hours before the show so we said, ‘Oh, great! Let’s have a ciggy and write a song!’ So that’s how we began ‘She Loves You’. I remember for some reason thinking of Bobby Rydell; he must have had a hit that we were interested in. I remember thinking of him and sitting on the bed in this hotel somewhere with John in the afternoon daylight.</div></blockquote><div class=\"source\">Paul McCartney<br>\n<a href=\"https://geni.us/manyyearsfromnow\" target=\"_blank\" rel=\"noopener\"><em>Many Years From Now</em></a>, Barry Miles</div><p>‘She Loves You’ was <a href=\"/1963/06/27/lennon-mccartney-finish-writing-she-loves-you/\">completed the following day</a> at McCartney’s family home, 20 Forthlin Road, Liverpool.</p><p><a href=\"/gallery/1963-photos/63-summer-itinerary_01/\" rel=\"attachment wp-att-108881\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI2MDQiIGhlaWdodD0iOTYwIiB2aWV3Qm94PSIwIDAgNjA0IDk2MCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" data-attachment-id=\"108881\" data-permalink=\"https://www.beatlesbible.com/gallery/1963-photos/63-summer-itinerary_01/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/63-summer-itinerary_01.jpg\" data-orig-size=\"1207,1917\" data-comments-opened=\"1\" data-image-title=\"The Beatles&amp;#8217; summer 1963 itinerary\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/63-summer-itinerary_01-604x960.jpg\" data-src=\"/wp/media/63-summer-itinerary_01-604x960.jpg\" alt=\"The Beatles' summer 1963 itinerary\" width=\"604\" height=\"960\" class=\"aligncenter size-large wp-image-108881\" data-srcset=\"https://www.beatlesbible.com/wp/media/63-summer-itinerary_01-604x960.jpg 604w, https://www.beatlesbible.com/wp/media/63-summer-itinerary_01-365x580.jpg 365w, https://www.beatlesbible.com/wp/media/63-summer-itinerary_01-126x200.jpg 126w, https://www.beatlesbible.com/wp/media/63-summer-itinerary_01-768x1220.jpg 768w, https://www.beatlesbible.com/wp/media/63-summer-itinerary_01-967x1536.jpg 967w, https://www.beatlesbible.com/wp/media/63-summer-itinerary_01.jpg 1207w\" data-sizes=\"(max-width: 604px) 100vw, 604px\"></a></p>\n<!--[googlesitekit-end-of-content]--><div style=\"font-size: 12px; margin: 10px 0 10px 0;\"><strong>Page last updated:</strong> 25 January 2024</div></div></div><div class=\"on-this-day-wrapper\"><h3>Also on this day...</h3><ul><li>2023: <a href=\"https://www.beatlesbible.com/2023/06/26/paul-mccartney-attends-eyes-of-the-storm-exhibition-launch/\">Paul McCartney attends Eyes Of The Storm exhibition launch</a></li><li>2019: <a href=\"https://www.beatlesbible.com/2019/06/26/paul-mccartney-live-talking-stick-resort-arena-phoenix/\">Paul McCartney live: Talking Stick Resort Arena, Phoenix</a></li><li>2018: <a href=\"https://www.beatlesbible.com/2018/06/26/ringo-starr-all-starr-band-live-palau-sant-jordi-barcelona/\">Ringo Starr and his All-Starr Band live: Palau Sant Jordi, Barcelona</a></li><li>2016: <a href=\"https://www.beatlesbible.com/2016/06/26/ringo-starr-all-starr-band-live-hartman-arena-park-city/\">Ringo Starr and his All-Starr Band live: Hartman Arena, Park City</a></li><li>2012: <a href=\"https://www.beatlesbible.com/2012/06/26/ringo-starr-all-starr-band-live-state-theatre-easton-4/\">Ringo Starr and his All-Starr Band live: State Theatre, Easton</a></li><li>2011: <a href=\"https://www.beatlesbible.com/2011/06/26/ringo-starr-all-starr-band-live-palais-des-sports-paris/\">Ringo Starr and his All-Starr Band live: Palais des Sports, Paris</a></li><li>2010: <a href=\"https://www.beatlesbible.com/2010/06/26/paul-mccartney-live-millennium-stadium-cardiff/\">Paul McCartney live: Millennium Stadium, Cardiff</a></li><li>2010: <a href=\"https://www.beatlesbible.com/2010/06/26/ringo-starr-all-starr-band-live-bethel-woods-center-arts-bethel/\">Ringo Starr and his All-Starr Band live: Bethel Woods Center for the Arts, Bethel</a></li><li>2009: <a href=\"https://www.beatlesbible.com/2009/06/26/paul-mccartney-pays-tribute-to-michael-jackson/\">Paul McCartney pays tribute to Michael Jackson</a></li><li>2004: <a href=\"https://www.beatlesbible.com/2004/06/26/paul-mccartney-live-glastonbury-festival/\">Paul McCartney live: Glastonbury Festival</a></li><li>2000: <a href=\"https://www.beatlesbible.com/2000/06/26/ringo-starr-all-starr-band-live-humphreys-concerts-by-the-bay-san-diego-4/\">Ringo Starr and his All-Starr Band live: Humphreys Concerts By The Bay, San Diego</a></li><li>1995: <a href=\"https://www.beatlesbible.com/1995/06/26/ringo-starr-all-starr-band-live-nippon-budokan-hall-tokyo-3/\">Ringo Starr and his All-Starr Band live: Nippon Budokan Hall, Tokyo</a></li><li>1992: <a href=\"https://www.beatlesbible.com/1992/06/26/ringo-starr-all-starr-band-live-riverport-amphitheatre-maryland-heights-2/\">Ringo Starr and his All-Starr Band live: Riverport Amphitheatre, Maryland Heights</a></li><li>1974: <a href=\"https://www.beatlesbible.com/1974/06/26/recording-wide-prairie-linda-mccartney/\">Recording: Wide Prairie by Linda McCartney</a></li><li>1974: <a href=\"https://www.beatlesbible.com/1974/06/26/wings-rehearse-nashville-12/\">Wings rehearse in Nashville</a></li><li>1974: <a href=\"https://www.beatlesbible.com/1974/06/26/paul-mccartney-writes-sally-g/\">Paul McCartney writes Sally G</a></li><li>1973: <a href=\"https://www.beatlesbible.com/1973/06/26/john-lennon-yoko-ono-attend-ms-magazine-party/\">John Lennon and Yoko Ono attend Ms magazine party</a></li><li>1970: <a href=\"https://www.beatlesbible.com/1970/06/26/recording-id-be-talking-all-the-time-15-draw-wine-women-and-loud-happy-songs-the-wishing-book-ringo-starr/\">Recording: I’d Be Talking All The Time, $15 Draw, Wine Women and Loud Happy Songs, The Wishing Book by Ringo Starr</a></li><li>1970: <a href=\"https://www.beatlesbible.com/1970/06/26/recording-awaiting-on-you-all-george-harrison/\">Recording: Awaiting On You All by George Harrison</a></li><li>1968: <a href=\"https://www.beatlesbible.com/1968/06/26/recording-everybodys-got-something-to-hide-except-me-and-my-monkey/\">Recording: Everybody’s Got Something To Hide Except Me And My Monkey</a></li><li>1968: <a href=\"https://www.beatlesbible.com/1968/06/26/george-harrison-produces-jackie-lomax-sour-milk-sea-3/\">George Harrison produces Jackie Lomax’s Sour Milk Sea</a></li><li>1967: <a href=\"https://www.beatlesbible.com/1967/06/26/recording-mixing-all-you-need-is-love/\">Recording, mixing: All You Need Is Love</a></li><li>1966: <a href=\"https://www.beatlesbible.com/1966/06/26/live-ernst-merck-halle-hamburg/\">The Beatles live: Ernst Merck Halle, Hamburg</a></li><li>1965: <a href=\"https://www.beatlesbible.com/1965/06/26/live-palazzo-dello-sport-genoa-italy/\">The Beatles live: Palazzo dello Sport, Genoa, Italy</a></li><li>1964: <a href=\"https://www.beatlesbible.com/1964/06/26/live-town-hall-dunedin-new-zealand/\">The Beatles live: Town Hall, Dunedin, New Zealand</a></li><li>1964: <a href=\"https://www.beatlesbible.com/1964/06/26/us-lp-a-hard-days-night/\">US album release: A Hard Day’s Night</a></li><li>1961: <a href=\"https://www.beatlesbible.com/1961/06/26/live-top-ten-club-hamburg-87/\">The Beatles live: Top Ten Club, Hamburg</a></li></ul><p>Want more? Visit the <a title=\"Day after day: the Beatles' history\" href=\"/history/\">Beatles history section</a>.</p></div><div class=\"gm-map\" style=\"position: relative;height: 390px; width: 100%;\"><iframe data-lazyloaded=\"1\" src=\"about:blank\" name=\"gm-map-1\" allowfullscreen=\"\" data-src=\"https://www.beatlesbible.com/?geo_mashup_content=render-map&amp;map_data_key=16e4c6c6ab636d49d001d2301daf0452&amp;height=390&amp;width=100%&amp;add_overview_control=false&amp;zoom=16&amp;enable_street_view=false&amp;map_type=G_HYBRID_MAP&amp;name=gm-map-1&amp;object_id=3818&amp;map_content=single\" style=\"position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; overflow: hidden;\" title=\"Geo Mashup Map\"></iframe></div>",
  "textContent": "The Beatles’ second and final concert at Newcastle’s Majestic Ballroom took place on 26 June 1963. They had previously appeared at the venue on 28 January 1963.This was the group’s final appearance in a ballroom run by Top Rank, although they continued to perform in cinemas and theatres operated by the company.Before the show, in a room at the Turk’s Hotel in Newcastle, John Lennon and Paul McCartney began writing their next single, ‘She Loves You’.\n\n\n\n\n\n\nJohn and I wrote ‘She Loves You’ together. There was a Bobby Rydell song [‘Forget Him’] out at the time and, as often happens, you think of one song when you write another.We were in a van up in Newcastle. I’d planned an ‘answering song’ where a couple of us would sing ‘She loves you…’ and the other one answers, ‘Yeah, yeah.’ We decided that that was a crummy idea as it was, but at least we then had the idea for a song called ‘She Loves You’. So we sat in the hotel bedroom for a few hours and wrote it.Paul McCartney\nAnthologyThey wrote while facing each other on twin beds in their shared hotel room.We must have had a few hours before the show so we said, ‘Oh, great! Let’s have a ciggy and write a song!’ So that’s how we began ‘She Loves You’. I remember for some reason thinking of Bobby Rydell; he must have had a hit that we were interested in. I remember thinking of him and sitting on the bed in this hotel somewhere with John in the afternoon daylight.Paul McCartney\nMany Years From Now, Barry Miles‘She Loves You’ was completed the following day at McCartney’s family home, 20 Forthlin Road, Liverpool.\nPage last updated: 25 January 2024Also on this day...2023: Paul McCartney attends Eyes Of The Storm exhibition launch2019: Paul McCartney live: Talking Stick Resort Arena, Phoenix2018: Ringo Starr and his All-Starr Band live: Palau Sant Jordi, Barcelona2016: Ringo Starr and his All-Starr Band live: Hartman Arena, Park City2012: Ringo Starr and his All-Starr Band live: State Theatre, Easton2011: Ringo Starr and his All-Starr Band live: Palais des Sports, Paris2010: Paul McCartney live: Millennium Stadium, Cardiff2010: Ringo Starr and his All-Starr Band live: Bethel Woods Center for the Arts, Bethel2009: Paul McCartney pays tribute to Michael Jackson2004: Paul McCartney live: Glastonbury Festival2000: Ringo Starr and his All-Starr Band live: Humphreys Concerts By The Bay, San Diego1995: Ringo Starr and his All-Starr Band live: Nippon Budokan Hall, Tokyo1992: Ringo Starr and his All-Starr Band live: Riverport Amphitheatre, Maryland Heights1974: Recording: Wide Prairie by Linda McCartney1974: Wings rehearse in Nashville1974: Paul McCartney writes Sally G1973: John Lennon and Yoko Ono attend Ms magazine party1970: Recording: I’d Be Talking All The Time, $15 Draw, Wine Women and Loud Happy Songs, The Wishing Book by Ringo Starr1970: Recording: Awaiting On You All by George Harrison1968: Recording: Everybody’s Got Something To Hide Except Me And My Monkey1968: George Harrison produces Jackie Lomax’s Sour Milk Sea1967: Recording, mixing: All You Need Is Love1966: The Beatles live: Ernst Merck Halle, Hamburg1965: The Beatles live: Palazzo dello Sport, Genoa, Italy1964: The Beatles live: Town Hall, Dunedin, New Zealand1964: US album release: A Hard Day’s Night1961: The Beatles live: Top Ten Club, HamburgWant more? Visit the Beatles history section.",
