MCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"147\" data-src=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_005-200x147.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"George and Pattie Harrison, 1966\" data-srcset=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_005-200x147.jpg 200w, https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_005-580x427.jpg 580w, https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_005-768x566.jpg 768w, https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_005.jpg 900w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"12129\" data-permalink=\"https://www.beatlesbible.com/gallery/1966-photos/66_george-harrison-pattie-boyd_005/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_005.jpg\" data-orig-size=\"900,663\" data-comments-opened=\"1\" data-image-title=\"George and Pattie Harrison, 1966\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_005.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon portrait\">\n<a href=\"https://www.beatlesbible.com/gallery/1966-photos/66_george-harrison-pattie-boyd_002/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxNDIiIGhlaWdodD0iMjAwIiB2aWV3Qm94PSIwIDAgMTQyIDIwMCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"142\" height=\"200\" data-src=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_002-142x200.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"George and Pattie Harrison, 1966\" data-srcset=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_002-142x200.jpg 142w, https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_002.jpg 248w\" data-sizes=\"(max-width: 142px) 100vw, 142px\" data-attachment-id=\"12126\" data-permalink=\"https://www.beatlesbible.com/gallery/1966-photos/66_george-harrison-pattie-boyd_002/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_002.jpg\" data-orig-size=\"248,350\" data-comments-opened=\"1\" data-comments-count=\"2\" data-image-title=\"George and Pattie Harrison, 1966\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/66_george-harrison-pattie-boyd_002.jpg\"></a></div></figure><figure class=\"gallery-item\"><div class=\"gallery-icon landscape\">\n<a href=\"https://www.beatlesbible.com/gallery/1964-photos/6405-george-harrison-john-lennon-tahiti_01/\"><img data-lazyloaded=\"1\" src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyMDAiIGhlaWdodD0iMTA2IiB2aWV3Qm94PSIwIDAgMjAwIDEwNiI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2NmZDRkYiIvPjwvc3ZnPg==\" decoding=\"async\" width=\"200\" height=\"106\" data-src=\"https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01-200x106.jpg\" class=\"attachment-thumbnail size-thumbnail\" alt=\"George Harrison and John Lennon disguised in Tahiti, May 1964\" data-srcset=\"https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01-200x106.jpg 200w, https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01-580x308.jpg 580w, https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01-768x407.jpg 768w, https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01-300x160.jpg 300w, https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01.jpg 826w\" data-sizes=\"(max-width: 200px) 100vw, 200px\" data-attachment-id=\"29525\" data-permalink=\"https://www.beatlesbible.com/gallery/1964-photos/6405-george-harrison-john-lennon-tahiti_01/\" data-orig-file=\"https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01.jpg\" data-orig-size=\"826,438\" data-comments-opened=\"1\" data-image-title=\"George Harrison and John Lennon disguised in Tahiti, May 1964\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://www.beatlesbible.com/wp/media/6405-george-harrison-john-lennon-tahiti_01.jpg\"></a></div></figure></div><div class=\"page-links\">Pages: <span class=\"post-page-numbers current\" aria-current=\"page\"><span class=\"page-link\">1</span></span> <a href=\"https://www.beatlesbible.com/people/pattie-boyd/2/\" class=\"post-page-numbers\"><span class=\"page-link\">2</span></a> <a href=\"https://www.beatlesbible.com/people/pattie-boyd/3/\" class=\"post-page-numbers\"><span class=\"page-link\">3</span></a> <a href=\"https://www.beatlesbible.com/people/pattie-boyd/4/\" class=\"post-page-numbers\"><span class=\"page-link\">4</span></a></div></div><div style=\"font-size: 12px; margin: 10px 0 10px 0;\"><strong>Published:</strong> <time itemprop=\"datePublished\" datetime=\"2008-05-22T22:58:01+01:00\" content=\"2008-05-22T22:58:01+01:00\">22 May 2008 </time> | <time itemprop=\"dateModified\" datetime=\"2026-06-05T15:13:34+01:00\" content=\"2026-06-05T15:13:34+01:00\"><strong>Last updated:</strong> 5 June 2026</time></div>",
  "textContent": "Beatle people » Pattie BoydPages: 1 2 3 4Pattie Boyd met George Harrison in 1964 on the set of the A Hard Day’s Night film. They married on 21 January 1966. We got on a train at Marylebone Station one day and the train took off – and suddenly we were in a film! And in the film there were little schoolgirls in gym-slips, who were actually models, and we were quite fascinated with them – George even married one: Pattie Boyd.Paul McCartney\nAnthologyShe was born Patricia Anne Boyd on 17 March 1944, in Taunton, Somerset. The eldest of four siblings, Boyd attended convent boarding schools until 1961, and moved to London the following year.Boyd began modeling in 1962, but was rejected by many photographers because of her unusual looks. She went on to model in London, New York and Paris, and was photographed by David Bailey and Terence Donovan; Twiggy later said she based her look on Boyd’s.Boyd met George Harrison in 1964, when she was 19, after being cast as a schoolgirl fan in A Hard Day’s Night. At the time she was in a relationship with another man, Eric Swayne, and initially declined Harrison’s request for a date.\n\nOn first impressions, John seemed more cynical and brash than the others, Ringo the most endearing, Paul was cute and George, with velvet-brown eyes and dark chestnut hair, was the best-looking man I had ever seen. At a break for lunch I found myself sitting next to him. Being close to him was electrifying.Pattie Boyd\nWonderful TodayOne of the first things he said to her was “Will you marry me?” When she laughed, Harrison said, “Well, if you won’t marry me, will you have dinner with me tonight?” Several days later, again on the film set, he asked her out once more and she accepted, having by then ended her relationship with Swayne.Their first date took place at the Garrick Club, a private gentlemen’s club in Covent Garden, London. Also present was The Beatles’ manager Brian Epstein, as Boyd later recounted in her 2007 autobiography Wonderful Today (Wonderful Tonight in the USA).I didn’t resent [Brian’s] presence on our first date – he was good company and seemed to know everything about wine, food and restaurants.And perhaps if George and I, two young, shy people, had been on our own in such a grown-up restaurant, it would have been too intense.As it was, we had a lovely evening and sat side by side on a banquette listening to Brian, hardly daring to touch each other’s hand.Pattie Boyd\nWonderful TodayBoyd and Harrison quickly became an item, and in May 1964 they went on holiday to Tahiti for four weeks with John and Cynthia Lennon. It was an attempt to escape from the pressures of Beatlemania, and each of them traveled under a false name – Boyd was Miss Bond, the girlfriend of Mr Hargreaves.Cynthia and Pattie had long black wigs which they wore as disguises. John and I put their wigs on, and our oilskin macs, and made a little 8mm film about natives on an island with a missionary, John, who comes out of the ocean to convert them.George Harrison\nAnthology\n\n\n\n\nPages: 1 2 3 4Published: 22 May 2008  | Last updated: 5 June 2026",
